# Variáveis da stack Swarm do CRM. Copie para `crm.env` (NÃO commite) e preencha.
#
#   cp crm.env.example crm.env && chmod 600 crm.env
#   set -a; . ./crm.env; set +a
#   docker stack deploy --with-registry-auth -c crm.stack.yml crm
#
# Regras do arquivo:
#   - não ponha aspas nem `$` nos valores (o shell expande `$`; gere segredos em hex);
#   - no Portainer, cole estas linhas em "Environment variables" da stack.

# ── Imagens ──────────────────────────────────────────────────────────────────
# latest = topo da `main` do fork. Para `stable`, crie uma tag vX.Y.Z no fork
# (o CI move o canal) e troque aqui. Também aceita um número, ex.: 1.124.0.
CRM_TAG=latest
CRM_DOMAIN=crm.cppem.com.br
TZ=America/Sao_Paulo

# ── Supabase (self-hosted, mesma rede MV8Net) ───────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://supabase.cppem.com.br
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Caminho interno do servidor até o Kong (padrão da stack; pode omitir).
SUPABASE_SERVER_URL=http://supabase_kong:8000
# Postgres DIRETO pela rede interna (não pelo pooler, não pela porta 5480).
SUPABASE_DB_URL=postgresql://postgres:SENHA@supabase_db:5432/postgres

# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://crm.cppem.com.br
NEXT_PUBLIC_ADMIN_URL=https://crm.cppem.com.br

# ── Segredos (gere cada um com `openssl rand -hex 32`) ──────────────────────
INTERNAL_SECRET=
CPF_ENCRYPTION_KEY=
WAHA_BYO_ENCRYPTION_KEY=
IMPERSONATE_COOKIE_SECRET=
LGPD_SIGNING_KEY=
NUVEMSHOP_OAUTH_ENCRYPTION_KEY=
# AI_CRED_AES_KEY é diferente: `openssl rand -base64 32`
AI_CRED_AES_KEY=

# ── WAHA / Redis ────────────────────────────────────────────────────────────
# WAHA_API_KEY = texto puro (o app envia). WAHA_API_KEY_SHA512 = o hash dele:
#   echo -n "$WAHA_API_KEY" | sha512sum | awk '{print $1}'
WAHA_API_KEY=
WAHA_API_KEY_SHA512=
WAHA_HMAC_SECRET=
# Token do SRH (também usado como UPSTASH_REDIS_REST_TOKEN)
SRH_TOKEN=

# ── Opcionais ───────────────────────────────────────────────────────────────
# IA (ou cadastre depois em IA › Credenciais)
AI_GATEWAY_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
# E-mail
RESEND_API_KEY=
RESEND_FROM_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=
# Marca / suporte
APP_NAME=
APP_LOGO_URL=
APP_ACCENT_HEX=
SUPPORT_EMAIL=
# Telemetria: off (padrão) ou comunidade
SENTRY_DSN=off

# ── Serviços opcionais (nascem desligados; 1 liga, 0 desliga) ───────────────
WACALLS_REPLICAS=0
ASTERISK_REPLICAS=0
VOICE_AGENT_REPLICAS=0
# Pasta no host com a cópia de asterisk/ (pjsip.conf e ari.conf já criados)
ASTERISK_CONF_DIR=/opt/crm/asterisk
# WaCalls (chamada de voz do WhatsApp). Com WACALLS_REPLICAS=1:
# WACALLS_API_BASE_URL=http://wacalls:8080
WACALLS_API_BASE_URL=
WACALLS_API_TOKEN=
WACALLS_ADMIN_USER=
WACALLS_ADMIN_PASSWORD=
WACALLS_PUBLIC_IP=
WACALLS_WEBRTC_UDP_PORT=7881
# Telefonia por SIP (asterisk + voice-agent)
ARI_USERNAME=
ARI_PASSWORD=
